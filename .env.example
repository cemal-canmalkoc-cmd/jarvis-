# =========================================================================
#  Jarvis – Hansa Personal
# =========================================================================

# ---------- Pflicht ----------
# console.anthropic.com
ANTHROPIC_API_KEY=
# kostenlose Adresse von duckdns.org
JARVIS_DOMAIN=hansa-jarvis.duckdns.org
JARVIS_PUBLIC_URL=https://hansa-jarvis.duckdns.org
# Nummer, von der DU Jarvis per WhatsApp steuerst (leer = nur App/Siri)
JARVIS_OWNER_WHATSAPP=
# deine E-Mail: Meldungen, wenn WhatsApp an dich nicht geht
JARVIS_OWNER_EMAIL=
# langes Zufallspasswort (App-Login + Siri)
JARVIS_ADMIN_TOKEN=

JARVIS_RECRUITER_NAME=Cemal-Can Malkoc
JARVIS_AGENCY_NAME=Hansa Personal
JARVIS_DAILY_TARGET=20
# nur Telefon: Jarvis nimmt Anrufe an (Umleitung zu Twilio)
JARVIS_CALL_IN_NUMBER=+49 151 28143836

# ---------- Kosten ----------
# 1 = Claude Haiku 5.5 (sehr günstig), 0 = Claude Opus 5.5 (beste Qualität)
JARVIS_SPARMODUS=1
# Websuchen pro Suchfokus (jede Suche kostet ca. 1 Rappen)
JARVIS_WEB_SEARCHES=3

# ---------- WhatsApp (Meta Cloud API, direkt & am günstigsten) ----------
JARVIS_WHATSAPP_PROVIDER=meta
# Jarvis' WhatsApp-Nummer (bei euch: die 0176 …) – bei Meta registriert
JARVIS_WHATSAPP_NUMBER=
# System-User-Token aus dem Meta Business Manager
META_WHATSAPP_TOKEN=
# aus WhatsApp → API-Setup
META_PHONE_NUMBER_ID=
# App-Einstellungen → Allgemein → App-Geheimcode
META_APP_SECRET=
# frei wählen, gleich wie bei der Webhook-Einrichtung
META_VERIFY_TOKEN=
# Name der freigegebenen Erstkontakt-Vorlage (optional)
META_TEMPLATE_FIRST_CONTACT=
META_TEMPLATE_LANG=de

# ---------- E-Mail (Kandidaten bei Kliniken vorstellen; dein bestehendes Postfach) ----------
JARVIS_SMTP_HOST=mail.gmx.net
JARVIS_SMTP_PORT=587
JARVIS_SMTP_USER=
JARVIS_SMTP_PASSWORD=
JARVIS_SMTP_FROM=

# ---------- Optional: KI-Telefonate (kostenpflichtig, Twilio) ----------
# Leer lassen = Jarvis gibt dir stattdessen eine Anrufliste mit Gesprächsleitfaden.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VOICE_FROM=
JARVIS_AUTO_CALL_CANDIDATES=1
# Arbeitgeber betreut der Schweizer Partner
JARVIS_AUTO_CALL_COMPANIES=0
JARVIS_MAX_CALLS_PER_ROUND=5
JARVIS_VOICE_LANGUAGE=de-DE

# ---------- Autopilot ----------
JARVIS_AUTOPILOT=1
JARVIS_MORNING_HOUR=7

# ---------- Optional: Bewerbungs-Postfach lesen ----------
JARVIS_IMAP_HOST=imap.gmx.net
JARVIS_IMAP_USER=
JARVIS_IMAP_PASSWORD=
JARVIS_IMAP_FOLDER=INBOX

# Selbstständiger Betrieb: KI beantwortet Bewerber (Chat + E-Mail) und Firmen
JARVIS_CHAT_MAX_USD=0.20      # höchstens $ pro Tag für KI-Gespräche
JARVIS_AUTO_DAYS=5            # Freigabe gilt 5 Tage, danach in der App „Weiter“ tippen
JARVIS_AUTO_INBOX=1           # Postfach lesen + beantworten (nutzt die SMTP-Zugangsdaten)
JARVIS_CHAT_FIRST=1           # Bewerber-Links führen zum KI-Chat statt in dein WhatsApp
