# ---------- Pflicht ----------
ANTHROPIC_API_KEY=
JARVIS_PUBLIC_URL=https://jarvis.deine-domain.ch     # öffentliche HTTPS-Adresse des Servers
JARVIS_OWNER_WHATSAPP=                               # DEINE Handynummer, z.B. +49176...
JARVIS_ADMIN_TOKEN=                                  # langes Zufallspasswort fürs Dashboard

JARVIS_RECRUITER_NAME=Ihr Name
JARVIS_AGENCY_NAME=Ihre Agentur
JARVIS_DAILY_TARGET=20

# ---------- Twilio (WhatsApp + Telefon) ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=          # Jarvis' WhatsApp-Business-Nummer, z.B. +4144...
TWILIO_VOICE_FROM=             # Jarvis' Telefonnummer (CH-Nummer empfohlen)
TWILIO_TEMPLATE_FIRST_CONTACT= # Content-SID der freigegebenen Erstkontakt-Vorlage (HX...)

# ---------- Autopilot ----------
JARVIS_AUTOPILOT=1
JARVIS_MORNING_HOUR=7
JARVIS_AUTO_CALL_CANDIDATES=1
JARVIS_AUTO_CALL_COMPANIES=1
JARVIS_MAX_CALLS_PER_ROUND=5

# ---------- Stimme (optional) ----------
JARVIS_VOICE_LANGUAGE=de-DE
JARVIS_VOICE_TTS_PROVIDER=     # z.B. ElevenLabs
JARVIS_VOICE_NAME=
JARVIS_VOICE_FAST_MODE=0       # 1 = schnellere Antworten am Telefon (doppelter Claude-Preis)

# ---------- Optional: Bewerbungs-Postfach ----------
JARVIS_IMAP_HOST=
JARVIS_IMAP_USER=
JARVIS_IMAP_PASSWORD=
JARVIS_IMAP_FOLDER=INBOX
