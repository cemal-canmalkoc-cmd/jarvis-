# =========================================================================
#  Jarvis – Hansa Personal
# =========================================================================

# ---------- Pflicht ----------
ANTHROPIC_API_KEY=                                   # console.anthropic.com
JARVIS_DOMAIN=hansa-jarvis.duckdns.org               # kostenlose Adresse von duckdns.org
JARVIS_PUBLIC_URL=https://hansa-jarvis.duckdns.org
JARVIS_OWNER_WHATSAPP=                               # DEINE Handynummer, z.B. +49176...
JARVIS_ADMIN_TOKEN=                                  # langes Zufallspasswort (App-Login + Siri)

JARVIS_RECRUITER_NAME=Cemal-Can Malkoc
JARVIS_AGENCY_NAME=Hansa Personal
JARVIS_DAILY_TARGET=20
JARVIS_CALL_IN_NUMBER=+49 151 28143836              # Hansa-Nummer für Kandidaten & Kliniken (Jarvis nimmt ab)

# ---------- Kosten ----------
JARVIS_SPARMODUS=1            # 1 = Claude Haiku 5.5 (sehr günstig), 0 = Claude Opus 5.5 (beste Qualität)
JARVIS_WEB_SEARCHES=3         # Websuchen pro Suchfokus (jede Suche kostet ca. 1 Rappen)

# ---------- WhatsApp (Meta Cloud API, direkt & am günstigsten) ----------
JARVIS_WHATSAPP_PROVIDER=meta
JARVIS_WHATSAPP_NUMBER=       # Jarvis' WhatsApp-Business-Nummer, z.B. +4144...
META_WHATSAPP_TOKEN=          # System-User-Token aus dem Meta Business Manager
META_PHONE_NUMBER_ID=         # aus WhatsApp → API-Setup
META_APP_SECRET=              # App-Einstellungen → Allgemein → App-Geheimcode
META_VERIFY_TOKEN=            # frei wählen, gleich wie bei der Webhook-Einrichtung
META_TEMPLATE_FIRST_CONTACT=  # Name der freigegebenen Erstkontakt-Vorlage (optional)
META_TEMPLATE_LANG=de

# ---------- E-Mail (Kandidaten bei Kliniken vorstellen; dein bestehendes Postfach) ----------
JARVIS_SMTP_HOST=mail.gmx.net
JARVIS_SMTP_PORT=587
JARVIS_SMTP_USER=
JARVIS_SMTP_PASSWORD=
JARVIS_SMTP_FROM=

# ---------- Optional: KI-Telefonate (kostenpflichtig, Twilio) ----------
# Leer lassen = Jarvis gibt dir stattdessen eine Anrufliste mit Gesprächsleitfaden.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VOICE_FROM=
JARVIS_AUTO_CALL_CANDIDATES=1
JARVIS_AUTO_CALL_COMPANIES=0   # Arbeitgeber betreut der Schweizer Partner
JARVIS_MAX_CALLS_PER_ROUND=5
JARVIS_VOICE_LANGUAGE=de-DE

# ---------- Autopilot ----------
JARVIS_AUTOPILOT=1
JARVIS_MORNING_HOUR=7

# ---------- Optional: Bewerbungs-Postfach lesen ----------
JARVIS_IMAP_HOST=imap.gmx.net
JARVIS_IMAP_USER=
JARVIS_IMAP_PASSWORD=
JARVIS_IMAP_FOLDER=INBOX
